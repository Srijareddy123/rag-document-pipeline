# ─────────────────────────────────────────────
# RAG Document Pipeline, Environment Variables
# ─────────────────────────────────────────────
# Copy to .env and edit for your environment.
# Default values shown below work for local development.
# DO NOT commit .env to source control.

# ── Embedding provider ──────────────────────────────────────────────────────
# 'local'   → sentence-transformers (all-MiniLM-L6-v2), fully offline (default)
# 'bedrock' → Amazon Titan Embeddings V2, requires AWS credentials (optional)
EMBEDDING_PROVIDER=local

# Model used when EMBEDDING_PROVIDER=local
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2

# ── AWS (only needed when EMBEDDING_PROVIDER=bedrock) ────────────────────────
# Use an IAM role or your AWS profile. Never commit keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Leave CHROMA_HOST empty to use local persistent mode (single-process).
# Set CHROMA_HOST=chromadb when running via docker compose (HTTP server mode).
CHROMA_HOST=
CHROMA_PORT=8001
CHROMA_COLLECTION=documents
CHROMA_PERSIST_DIR=./chroma_data

# ── Ingestion pipeline ───────────────────────────────────────────────────────
# Chunking strategy: 'fixed' (default), 'semantic' or 'recursive'
CHUNK_STRATEGY=fixed

# Number of chunks per embedding batch. Reduce if you hit memory limits.
EMBED_BATCH_SIZE=32

# Documents processed at a time. Peak memory follows this, not the corpus size.
DOC_BATCH_SIZE=200

# Where scripts/fetch_corpus.py stores the public corpus (outside the repo)
# CORPUS_DIR=~/.cache/rag-document-pipeline

# ── API server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
